{
  "name": "selfhosted-stream-aggregator-addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Stremio/Nuvio stream aggregator addon with validation, European language matching and transcoding presets.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:metadata": "tsx src/streams/parse-stream-metadata.examples.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.1.2",
    "fastify": "^4.28.1",
    "pino-pretty": "^11.2.2",
    "puppeteer": "^22.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
